{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/vate/browser",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://vate-api.vercel.app/api/v1/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
